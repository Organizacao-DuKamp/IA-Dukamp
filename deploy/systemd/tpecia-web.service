[Unit]
Description=TPEC-IA SSR and API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tpecia
Group=tpecia
WorkingDirectory=/opt/tpecia/current
ExecStart=/usr/local/bin/node --env-file=/etc/tpecia/tpecia.env scripts/start.mjs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=27min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tpecia
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tpecia-web

[Install]
WantedBy=multi-user.target
