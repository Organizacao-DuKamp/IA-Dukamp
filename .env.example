# ============================================================
# TPEC-IA — Variáveis de ambiente
# ============================================================
# NUNCA comite este arquivo preenchido.
# Nenhum segredo pode usar prefixo VITE_.

# ------------------------------------------------------------------
# 1) EXECUÇÃO HÍBRIDA DO CHAT
# ------------------------------------------------------------------
# Lovable Cloud: executa o backend privilegiado localmente.
# Se ausente, o valor padrão é local para preservar o comportamento existente.
TPEC_BACKEND_MODE=local

# Netlify: use proxy e a URL HTTPS real da aplicação publicada no Lovable.
# TPEC_BACKEND_MODE=proxy
# LOVABLE_BACKEND_URL=https://sua-aplicacao.lovable.app

# Mesmo segredo grande e aleatório no Lovable e na Netlify.
# Use pelo menos 32 caracteres; recomendado gerar 48+ bytes aleatórios.
TPEC_PROXY_SECRET=<segredo-grande-e-aleatorio>

# Timeout opcional do proxy, entre 5000 e 60000 ms.
# TPEC_PROXY_TIMEOUT_MS=60000

# ------------------------------------------------------------------
# 2) CÉREBRO DA TPEC-IA — OPENAI / CHATGPT-FIRST ADAPTATIVO
# ------------------------------------------------------------------
# Obrigatória no backend que executa o chat. A mesma OpenAI faz raciocínio,
# síntese e Web Search pela Responses API. Não existe mais provedor Perplexity.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# O roteador escolhe o tier por turno para equilibrar qualidade, velocidade e custo:
# - Luna: conversa leve e respostas operacionais muito simples;
# - Terra: padrão para a maior parte da pecuária e pesquisas atuais;
# - Sol: cálculo/diagnóstico/análise complexa e escalada após falha de validação.
# Se estas variáveis não forem definidas, os IDs abaixo já são os padrões do código.
# OPENAI_TPEC_LUNA_MODEL=gpt-5.6-luna
# OPENAI_TPEC_TERRA_MODEL=gpt-5.6-terra
# OPENAI_TPEC_SOL_MODEL=gpt-5.6-sol

# Compatibilidade legada: OPENAI_TPEC_MODEL, se ainda existir no ambiente,
# funciona apenas como fallback do tier Sol. Ele não desativa mais o roteamento
# Luna/Terra/Sol e não força todas as perguntas para o modelo flagship.
# OPENAI_TPEC_MODEL=gpt-5.6-sol

# Modelos de mídia continuam configuráveis separadamente.
OPENAI_MEDIA_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_MEDIA_IMAGE_DETAIL=auto

# A base interna só bloqueia o fallback de pesquisa quando o match é forte.
# Faixa permitida no código: 0.60 a 0.95. Padrão: 0.72.
# TPEC_KNOWLEDGE_MIN_SIMILARITY=0.72

# ------------------------------------------------------------------
# 3) BACKEND PRIVILEGIADO — SOMENTE LOVABLE / MODO LOCAL
# ------------------------------------------------------------------
# O Lovable Cloud injeta/gerencia estas credenciais internamente.
# A Netlify em modo proxy NÃO precisa e NÃO deve receber estas chaves.
SUPABASE_URL=https://<project-ref-principal>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LOVABLE_API_KEY=lovable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Valores públicos do Supabase principal usados pela autenticação/UI administrativa.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_URL=https://<project-ref-principal>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=<project-ref-principal>
SUPABASE_PROJECT_ID=<project-ref-principal>

# ------------------------------------------------------------------
# 4) SUPABASE SECUNDÁRIO — SITE DUKAMP
# ------------------------------------------------------------------
# Mantido como integração somente leitura. Use anon/publishable, nunca service role.
DUKAMP_SITE_SUPABASE_URL=https://<dukamp-project-ref>.supabase.co
DUKAMP_SITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------
# 5) WHATSAPP CLOUD API — SERVER-SIDE
# ------------------------------------------------------------------
# Token aleatório escolhido por você e repetido no campo "Verificar token"
# da configuração do webhook no painel da Meta.
WHATSAPP_VERIFY_TOKEN=<token-de-verificacao-grande-e-aleatorio>

# App Secret em Meta for Developers > Configurações do app > Básico.
# Usado para validar x-hub-signature-256 em cada webhook recebido.
WHATSAPP_APP_SECRET=<meta-app-secret>

# Credencial da Cloud API. Nunca envie para o browser nem use prefixo VITE_.
# Na arquitetura proxy, configure-a na Netlify para envio e no Lovable para
# baixar e analisar áudio, imagem, vídeo e documento recebidos.
WHATSAPP_ACCESS_TOKEN=<meta-whatsapp-access-token>
WHATSAPP_PHONE_NUMBER_ID=<meta-phone-number-id>

# Versão da Graph API usada pelo app. Atualize quando migrar a versão na Meta.
WHATSAPP_GRAPH_API_VERSION=v25.0

# Timeout opcional do download/análise de mídia, entre 5000 e 30000 ms.
# TPEC_WHATSAPP_MEDIA_TIMEOUT_MS=20000

# ------------------------------------------------------------------
# 6) OPCIONAIS
# ------------------------------------------------------------------
# NODE_ENV=production
# RATE_LIMIT_MAX=15
# RATE_LIMIT_WINDOW_MS=60000


# ------------------------------------------------------------------
# 7) TELEMETRIA E CUSTOS DA IA (OPCIONAL)
# ------------------------------------------------------------------
# O painel /admin/ia registra tokens por turno e calcula custo estimado em
# dólar. Preencha com as tarifas da sua conta OpenAI (USD por 1 milhão de
# tokens). Sem as tarifas dos tiers adaptativos, o painel sinaliza que o
# total pode estar subestimado.
# OPENAI_TPEC_LUNA_INPUT_USD_PER_1M=0
# OPENAI_TPEC_LUNA_CACHED_INPUT_USD_PER_1M=0
# OPENAI_TPEC_LUNA_OUTPUT_USD_PER_1M=0
# OPENAI_TPEC_TERRA_INPUT_USD_PER_1M=0
# OPENAI_TPEC_TERRA_CACHED_INPUT_USD_PER_1M=0
# OPENAI_TPEC_TERRA_OUTPUT_USD_PER_1M=0
# OPENAI_TPEC_SOL_INPUT_USD_PER_1M=0
# OPENAI_TPEC_SOL_CACHED_INPUT_USD_PER_1M=0
# OPENAI_TPEC_SOL_OUTPUT_USD_PER_1M=0
# OPENAI_TPEC_DEFAULT_INPUT_USD_PER_1M=0
# OPENAI_TPEC_DEFAULT_OUTPUT_USD_PER_1M=0
# OPENAI_MEDIA_INPUT_USD_PER_1M=0
# OPENAI_MEDIA_CACHED_INPUT_USD_PER_1M=0
# OPENAI_MEDIA_OUTPUT_USD_PER_1M=0
# OPENAI_EMBEDDING_INPUT_USD_PER_1M=0
# OPENAI_WEB_SEARCH_USD_PER_CALL=0
# OPENAI_TRANSCRIPTION_USD_PER_MINUTE=0
